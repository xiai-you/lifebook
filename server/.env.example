# ===== LifeBook 后端环境变量示例 =====
# 复制为 .env 并填入真实值。

# 服务
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# CORS 允许来源：生产环境填写前端域名，逗号分隔（如 https://lifebook.example.com）；
# 留空表示开发环境放开。
CORS_ORIGIN=

# 数据库：
#   本机开发（无 Docker/PostgreSQL 时）用 SQLite：file:./dev.db
#   生产环境用 PostgreSQL：postgresql://lifebook:lifebook@localhost:5432/lifebook?schema=public
#   ⚠️ 生产上线前需把 prisma/schema.prisma 的 provider 从 sqlite 改为 postgresql，再执行 prisma db push。
DATABASE_URL="file:./dev.db"

# 上传文件持久目录（生产指向持久卷，如 /data/uploads；默认 <cwd>/uploads）
UPLOAD_DIR=

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# OAuth（微信 / Apple）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# AI 写作（接入后填写）
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=
