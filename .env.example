# ============================================================
# LifeBook 前端环境变量（复制为 .env.local 使用）
# ============================================================

# 前端 API 模式：
#   mock —— 默认，使用内存 Mock 数据（无需后端）
#   http —— 连接真实 NestJS 后端
NEXT_PUBLIC_API_MODE=mock

# http 模式下 API 基址。留空则使用相对路径 /api/v1，
# 由 next.config.mjs 的 rewrites 代理到 API_PROXY_TARGET。
NEXT_PUBLIC_API_URL=

# 服务端（SSR / generateMetadata）访问后端的绝对地址。
# 浏览器端仍走 NEXT_PUBLIC_API_URL 或 /api/v1 代理；服务端必须用绝对 URL。
API_URL=http://localhost:3001/api/v1

# 开发环境后端代理目标（next.config.mjs rewrites 使用）
API_PROXY_TARGET=http://localhost:3001

# ============================================================
# 生产部署说明
# ============================================================
# 1. 前端生产构建：NEXT_PUBLIC_API_MODE=http；若前后端同域由网关反代，
#    NEXT_PUBLIC_API_URL 留空（走 /api/v1 相对路径）；否则填后端公开地址。
# 2. SSR 服务端必须能访问后端绝对地址：设置 API_URL 为后端公开地址（不能是 localhost）。
# 3. 后端生产：DATABASE_URL 切 PostgreSQL、JWT_SECRET 用强随机值、CORS_ORIGIN 填前端域名。
#    上传目录用 UPLOAD_DIR 指向持久卷（默认 <cwd>/uploads）。
